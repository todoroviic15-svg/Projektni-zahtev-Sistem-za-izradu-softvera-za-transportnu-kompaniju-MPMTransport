unit Unit9;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes, System.Variants,
  FMX.Types, FMX.Controls, FMX.Forms, FMX.Graphics, FMX.Dialogs, System.Rtti,
  FMX.Grid.Style, FMX.Grid, Data.DB, Data.Win.ADODB, FMX.StdCtrls,
  FMX.Controls.Presentation, FMX.ScrollBox, System.StrUtils;

type
  TForm9 = class(TForm)
    ADOQueryVoznje: TADOQuery;
    StringGridVoznje: TStringGrid;
    btnDetalji: TButton;
    ADOConnection1: TADOConnection;
    IntegerColumn1: TIntegerColumn;
    DateTimeColumn1: TDateTimeColumn;
    StringColumn1: TStringColumn;
    IntegerColumn2: TIntegerColumn;
    IntegerColumn3: TIntegerColumn;
    DateTimeColumn2: TDateTimeColumn;
    StringColumn2: TStringColumn;
    IntegerColumn4: TIntegerColumn;
    StringColumn3: TStringColumn;
    SpeedButton1: TSpeedButton;
    procedure FormShow(Sender: TObject);
    procedure StringGridVoznjeCellClick(const Column: TColumn;
      const Row: Integer);
    procedure btnDetaljiClick(Sender: TObject);
    procedure SpeedButton1Click(Sender: TObject);
  private

   SelectedID: Integer;
   procedure UcitajVoznje;
  public
    { Public declarations }
  end;

var
  Form9: TForm9;

implementation


procedure TForm9.UcitajVoznje;
var
  Row: Integer;
  Status: string;
begin
  ADOQueryVoznje.Close;
  ADOQueryVoznje.SQL.Text := 'SELECT * FROM T_Voznja ORDER BY ID DESC';
  ADOQueryVoznje.Open;


  StringGridVoznje.RowCount := 1;

  Row := 1;

  while not ADOQueryVoznje.Eof do
  begin
    StringGridVoznje.RowCount := Row + 1;

    if ADOQueryVoznje.FieldByName('VremeKraja').IsNull then
      Status := 'U toku'
    else
      Status := 'Zavrsena';

    StringGridVoznje.Cells[0, Row] := ADOQueryVoznje.FieldByName('ID').AsString;
    StringGridVoznje.Cells[1, Row] := Status;
    StringGridVoznje.Cells[2, Row] := FormatDateTime('hh:nn', VarToDateTime(ADOQueryVoznje.FieldByName('VremePocetka').Value));
    StringGridVoznje.Cells[3, Row] := ADOQueryVoznje.FieldByName('LokacijaPocetak').AsString;
    StringGridVoznje.Cells[4, Row] := ADOQueryVoznje.FieldByName('GorivoPocetak').AsString;
    StringGridVoznje.Cells[5, Row] := ADOQueryVoznje.FieldByName('TrajanjeSekunde').AsString;
    if not ADOQueryVoznje.FieldByName('VremeKraja').IsNull
      then StringGridVoznje.Cells[6, Row] := FormatDateTime('hh:nn', VarToDateTime(ADOQueryVoznje.FieldByName('VremeKraja').Value))
    else
  StringGridVoznje.Cells[6, Row] := '-';
    StringGridVoznje.Cells[7, Row] := ADOQueryVoznje.FieldByName('LokacijaKraj').AsString;
    StringGridVoznje.Cells[8, Row] := ADOQueryVoznje.FieldByName('GorivoKraj').AsString;

    Inc(Row);
    ADOQueryVoznje.Next;
  end;

  ADOQueryVoznje.Close;
end;

{$R *.fmx}

procedure TForm9.btnDetaljiClick(Sender: TObject);
begin
          if SelectedID = 0 then
  begin
    ShowMessage('Izaberi vožnju iz tabele!');
    Exit;
  end;

  ADOQueryVoznje.Close;
  ADOQueryVoznje.SQL.Text :=
    'SELECT * FROM T_Voznja WHERE ID = :ID';

  ADOQueryVoznje.Parameters.ParamByName('ID').Value := SelectedID;
  ADOQueryVoznje.Open;


  ShowMessage(
    'ID: ' + ADOQueryVoznje.FieldByName('ID').AsString + sLineBreak +
    'Pocetak: ' + FormatDateTime('hh:nn',
      VarToDateTime(ADOQueryVoznje.FieldByName('VremePocetka').Value)) + sLineBreak +
    'Kraj: ' +
      IfThen(ADOQueryVoznje.FieldByName('VremeKraja').IsNull,
        '-',
        FormatDateTime('hh:nn',
          VarToDateTime(ADOQueryVoznje.FieldByName('VremeKraja').Value))
      ) + sLineBreak +
    'Start lokacija: ' + ADOQueryVoznje.FieldByName('LokacijaPocetak').AsString + sLineBreak +
    'Kraj lokacija: ' + ADOQueryVoznje.FieldByName('LokacijaKraj').AsString + sLineBreak +
    'Gorivo pocetak: ' + ADOQueryVoznje.FieldByName('GorivoPocetak').AsString + sLineBreak +
    'Gorivo kraj: ' + ADOQueryVoznje.FieldByName('GorivoKraj').AsString
  );
end;


procedure TForm9.FormShow(Sender: TObject);
begin
       ADOConnection1.Connected := True;
  UcitajVoznje;
end;



procedure TForm9.SpeedButton1Click(Sender: TObject);
begin
   Form5.Show;
   Close;
end;

procedure TForm9.StringGridVoznjeCellClick(const Column: TColumn;
  const Row: Integer);
begin
                SelectedID := StrToIntDef(StringGridVoznje.Cells[0, Row], 0);
end;

end.
