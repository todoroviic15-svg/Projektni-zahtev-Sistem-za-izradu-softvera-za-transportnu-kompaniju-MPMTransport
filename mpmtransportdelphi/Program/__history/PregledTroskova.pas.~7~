unit PregledTroskova;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes, System.Variants,
  FMX.Types, FMX.Controls, FMX.Forms, FMX.Graphics, FMX.Dialogs,
  FMX.Controls.Presentation, FMX.StdCtrls, System.Rtti, FMX.Grid.Style,
  FMX.Grid, Data.DB, Data.Win.ADODB, FMX.ScrollBox, FMX.ListBox,
  FMX.DateTimeCtrls;

type
  TForm11 = class(TForm)
    SpeedButton1: TSpeedButton;
    dtOd: TDateEdit;
    dtDo: TDateEdit;
    cmbKategorija: TComboBox;
    cmbVozilo: TComboBox;
    cmbVozac: TComboBox;
    btnPrikazi: TButton;
    grid: TStringGrid;
    lblUkupno: TLabel;
    ADOConnection1: TADOConnection;
    ADOQuery1: TADOQuery;
    StringColumn1: TStringColumn;
    StringColumn2: TStringColumn;
    StringColumn3: TStringColumn;
    StringColumn4: TStringColumn;
    StringColumn5: TStringColumn;
    StringColumn6: TStringColumn;
    StringColumn7: TStringColumn;
    StringColumn8: TStringColumn;
    procedure SpeedButton1Click(Sender: TObject);
    procedure FormCreate(Sender: TObject);
  private
   procedure PopuniFiltere;

    { Private declarations }
  public
    { Public declarations }
  end;

var
  Form11: TForm11;

implementation
uses Menadzer;

{$R *.fmx}

procedure TFormPregledTroskova.PopuniFiltere;
begin
      cmbKategorija.Items.Clear;
  cmbKategorija.Items.Add('Sve kategorije');
  ADOQuery1.Close;
  ADOQuery1.SQL.Text := 'SELECT ID, Naziv FROM KategorijaTroska ORDER BY Naziv';
  ADOQuery1.Open;
  while not ADOQuery1.Eof do
  begin
    cmbKategorija.Items.AddObject(ADOQuery1.FieldByName('Naziv').AsString,
      TObject(ADOQuery1.FieldByName('ID').AsInteger));
    ADOQuery1.Next;
  end;
  ADOQuery1.Close;
  cmbKategorija.ItemIndex := 0;

  // Vozila
  cmbVozilo.Items.Clear;
  cmbVozilo.Items.Add('Sva vozila');
  ADOQuery1.SQL.Text := 'SELECT ID, RegistarskiBroj FROM Vozila';
  ADOQuery1.Open;
  while not ADOQuery1.Eof do
  begin
    cmbVozilo.Items.AddObject(ADOQuery1.FieldByName('RegistarskiBroj').AsString,
      TObject(ADOQuery1.FieldByName('ID').AsInteger));
    ADOQuery1.Next;
  end;
  ADOQuery1.Close;
  cmbVozilo.ItemIndex := 0;
end;

procedure TForm11.FormCreate(Sender: TObject);
begin
ADOConnection1.ConnectionString :=
    'Provider=Microsoft.Jet.OLEDB.4.0;' +
    'Data Source=' + ExtractFilePath(ParamStr(0)) + 'mpmtransport.mdb;';
  ADOConnection1.LoginPrompt := False;
  ADOConnection1.Connected := True;

  dtOd.Date := EncodeDate(YearOf(Date), MonthOf(Date), 1);
  dtDo.Date := Date;
  PopuniFiltere;
end;

procedure TForm11.SpeedButton1Click(Sender: TObject);
begin
         Close;
         Form3.Show;
end;

end.
